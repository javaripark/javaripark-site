# Porta do servidor local
PORT=3100

# Token de autenticação — o dashboard precisa mandar este token em cada chamada.
# GERE UM VALOR ALEATÓRIO LONGO. Ex: openssl rand -hex 32
AUTH_TOKEN=troque-isto-por-um-token-secreto-longo

# ── Trava anti-ban ──
# Limite de mensagens por dia (começa conservador, sobe gradual)
DAILY_CAP=40

# Delay aleatório entre envios, em segundos (mín e máx)
MIN_DELAY_SEC=45
MAX_DELAY_SEC=120

# Janela de horário permitida (24h). Fora disso, a fila pausa.
SEND_WINDOW_START=11
SEND_WINDOW_END=21

# Aquecimento: nos primeiros N dias, o limite diário é reduzido.
# Dia 1 = 25% do cap, sobe até 100% no dia WARMUP_DAYS.
WARMUP_DAYS=7

# Palavras que, recebidas do cliente, ativam opt-out automático
OPTOUT_KEYWORDS=PARAR,SAIR,CANCELAR,REMOVER,STOP
