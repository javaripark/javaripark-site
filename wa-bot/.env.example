# ===== Claude (obrigatório) =====
# Crie em https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-...
# Modelo do atendimento (Haiku = barato e rápido)
CLAUDE_MODEL=claude-haiku-4-5-20251001

# ===== WhatsApp Cloud API (obrigatório pra produção; o simulador roda sem) =====
# Token permanente do system user (Business Manager → Usuários do sistema)
META_TOKEN=
# ID do número de telefone (painel do app → WhatsApp → Configuração da API)
META_PHONE_NUMBER_ID=
# Segredo do app (painel do app → Configurações → Básico → Chave Secreta)
META_APP_SECRET=
# Token de verificação do webhook — invente um valor e repita no painel da Meta
META_VERIFY_TOKEN=javari-webhook-2026

# ===== Servidor =====
PORT=3200

# ===== Custos exibidos no simulador =====
USD_BRL=5.50

# Número (com DDI) que recebe alerta de handoff via WhatsApp — deixe vazio pra desativar
ADMIN_PHONE=
