rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Blindagem 10/06/2026: acesso só pra admin autenticado (Firebase Auth).
    // Bot na nuvem usa OAuth de service account (IAM ignora estas rules).
    // Sync do Consumer POS usa Admin SDK (idem).
    match /artifacts/central-de-reservas-jsp/public/data/{document=**} {
      allow read, write: if request.auth != null
        && request.auth.token.email == 'admin@javaripark.com.br';
    }

    // Proposta de eventos: o CLIENTE abre o link público — só leitura, só aqui.
    match /artifacts/central-de-reservas-jsp/public/data/eventos_propostas/{id} {
      allow read: if true;
    }
  }
}
